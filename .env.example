# Postgres connection string (Neon's free tier works). Leave it out locally to
# use the built-in PGlite database in .data/
DATABASE_URL=

# Vercel Cron sends this as a bearer token to /api/cron/*. Required in production.
CRON_SECRET=

# Optional. With both set, emails also go out through Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. Public URL for links in emails and QR codes. Vercel's own URL is used when unset.
APP_URL=
